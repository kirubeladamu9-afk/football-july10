# MySQL Database Configuration
# These are provided by your Railway MySQL instance
MYSQLHOST=your-railway-private-domain.railway.app
MYSQLUSER=root
MYSQLPASSWORD=your-mysql-root-password
MYSQLDATABASE=railway
MYSQLPORT=3306

# JWT Configuration
# Change this to a secure random string in production
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# Optional: Public MySQL URL for external connections
# MYSQL_PUBLIC_URL=mysql://root:password@your-domain:port/railway

# Optional: Full MySQL URL
# MYSQL_URL=mysql://root:password@your-private-domain:3306/railway
